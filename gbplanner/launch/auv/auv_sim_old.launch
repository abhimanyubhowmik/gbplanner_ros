<launch>
  <!-- All settings -->
  <arg name="robot_name" default="rmf_obelix"/>
  <arg name="rviz_en" default="true" />
  <arg name="launch_prefix" default=""/> <!-- gdb -ex run //args -->
  <arg name="use_sim_time" default="true"/>
  <param name="use_sim_time" value="$(arg use_sim_time)"/>
  <!-- Config files -->
  <arg name="gbplanner_config_file" default="$(find gbplanner)/config/$(arg robot_name)/gbplanner_config.yaml"/>
  <arg name="pci_file" default="$(find gbplanner)/config/$(arg robot_name)/planner_control_interface_sim_config.yaml"/>
  <arg name="voxblox_config_file" default="$(find voxblox_ros)/cfg/holoocean_voxblox.yaml"/>
  <arg name="map_config_file" default="$(arg voxblox_config_file)"/>
  <!-- Static TF -->
  <node pkg="tf" type="static_transform_publisher" name="tf_world_nav" args="0 0 0 0 0 0 world navigation 100" />
  <!-- Static transforms matching HoloOcean setup -->
  <node pkg="tf" type="static_transform_publisher" name="tf_base_depth" args="0.5 0 0 0 0 0 base_link camera_depth 10" />
  <node pkg="tf" type="static_transform_publisher" name="tf_base_rgb" args="0.5 0 0 0 0 0 base_link camera_rgb 10" />
  <node pkg="tf" type="static_transform_publisher" name="tf_base_cam0" args="0.5 -0.05 0 0 0 0 base_link cam0 10" />
  <node pkg="tf" type="static_transform_publisher" name="tf_base_cam1" args="0.5 0.05 0 0 0 0 base_link cam1 10" />
  <!-- Optical frame transforms -->
  <node pkg="tf" type="static_transform_publisher" name="tf_depth_optical" args="0 0 0 0.5 -0.5 0.5 -0.5 camera_depth camera_depth_optical_frame 10" />
  <node pkg="tf" type="static_transform_publisher" name="tf_rgb_optical" args="0 0 0 0.5 -0.5 0.5 -0.5 camera_rgb camera_rgb_optical_frame 10" />
  <node pkg="tf" type="static_transform_publisher" name="tf_cam0_optical" args="0 0 0 0.5 -0.5 0.5 -0.5 cam0 cam0_optical_frame 10" />
  <node pkg="tf" type="static_transform_publisher" name="tf_cam1_optical" args="0 0 0 0.5 -0.5 0.5 -0.5 cam1 cam1_optical_frame 10" />
  <!-- Include Voxblox launch file -->
  <include file="$(find voxblox_ros)/launch/holoocean_voxblox.launch">
    <arg name="voxel_size" value="0.20"/>
    <arg name="voxblox_config_file" value="$(arg voxblox_config_file)"/>
  </include>
  <!-- Define your odometry topic from HoloOcean -->
  <arg name="odometry_topic" default="/rovio/odometry"/>
  <node name="odometry_throttler" type="throttle" pkg="topic_tools" args="messages $(arg odometry_topic) 10 $(arg odometry_topic)_throttled" />
  
  <!-- Message type converter for pose (in case pose_converter isn't working correctly) -->
  <node pkg="topic_tools" type="transform" name="pose_type_converter"
        args="/holoocean/pose_with_covariance /holoocean/current_pose_stamped geometry_msgs/PoseWithCovarianceStamped 
              'geometry_msgs.msg.PoseWithCovarianceStamped(header=m.header, pose=m.pose)' --import geometry_msgs.msg" />
  
  <!-- Graph based planning -->
  <node pkg="gbplanner" type="gbplanner_node" name="gbplanner_node" output="screen" launch-prefix="$(arg launch_prefix)">
    <remap from="odometry" to="$(arg odometry_topic)_throttled" />
    <remap from="/pointcloud" to="/camera/depth/points" />
    <remap from="pose" to="/holoocean/current_pose_stamped" /> <!-- Use converted pose -->
    <rosparam command="load" file="$(arg gbplanner_config_file)" />
    <rosparam command="load" file="$(arg map_config_file)" />
  </node>
  <!-- Planner and Control Interface -->
  <node pkg="pci_general" type="pci_general_ros_node" name="pci_general_ros_node" output="screen">
    <remap from="command/trajectory" to="$(arg robot_name)/command/trajectory" />
    <remap from="planner_server" to="gbplanner" />
    <remap from="planner_homing_server" to="gbplanner/homing" />
    <remap from="odometry" to="$(arg odometry_topic)_throttled"/>
    <rosparam command="load" file="$(arg pci_file)" />
  </node>
  <!-- RViz for visualization -->
  <group if="$(arg rviz_en)">
    <node pkg="rviz" type="rviz" name="gbplanner_ui" output="screen" args="-d $(find gbplanner)/config/rviz/rmf_obelix.rviz"/>
  </group>
</launch>