<!-- <?xml version="1.0" encoding="ISO-8859-15"?> -->
<launch>
  <!-- All settings -->
  <arg name="robot_name" default="auv_holoocean"/>
  <arg name="rviz_en" default="true" />
  <arg name="launch_prefix" default=""/> <!-- gdb -ex run //args -->
  <arg name="use_sim_time" value="false"/>
  <!-- <param name="use_sim_time" value="$(arg use_sim_time)"/> -->
  
  <!-- Config files -->
  <arg name="gbplanner_config_file" default="$(find gbplanner)/config/$(arg robot_name)/gbplanner_config.yaml"/>
  <arg name="pci_file" default="$(find gbplanner)/config/$(arg robot_name)/planner_control_interface_sim_config.yaml"/>
  <!-- <arg name="voxblox_config_file" default="$(find voxblox_ros)/cfg/holoocean_voxblox.yaml"/> -->
  <arg name="voxblox_config_file" default="$(find gbplanner)/config/$(arg robot_name)/holoocean_voxblox.yaml"/>
  <arg name="map_config_file" default="$(arg voxblox_config_file)"/>
  
  <!-- Static TF -->
  <node pkg="tf" type="static_transform_publisher" name="tf_world_nav" args="0 0 0 0 0 0 world navigation 100" />
  
  <!-- Graph based planning -->
  <!-- Remapping to use HoloOcean's topics -->
  <node pkg="gbplanner" type="gbplanner_node" name="gbplanner_node" output="screen" launch-prefix="$(arg launch_prefix)">
    <remap from="odometry" to="/odometry" />
    <remap from="pointcloud" to="/camera/depth/points" />
    <remap from="freespace_pointcloud" to="/camera/depth/freespace_points"/>
    <remap from="confidence" to="/camera/depth/confidence"/>
    <!-- <remap from="/voxblox_node/surface_pointcloud" to="/voxblox_node/surface_pointcloud" />
    <remap from="/voxblox_node/mesh" to="/voxblox_node/mesh" />
    <remap from="/voxblox_node/tsdf_map_out" to="/voxblox_node/tsdf_map_out" />
    <remap from="/voxblox_node/get_tsdf_es_distance" to="/voxblox_node/get_tsdf_es_distance" /> -->
    <rosparam command="load" file="$(arg gbplanner_config_file)" />
    <rosparam command="load" file="$(find voxblox_ros)/cfg/calibrations/holoocean_camera.yaml" />
    <rosparam command="load" file="$(arg map_config_file)" />
  </node>
  
  <!-- Planner and Control Interface -->
  <node pkg="pci_general" type="pci_general_ros_node" name="pci_general_ros_node" output="screen">
    <remap from="pci_command_path" to="/pci_command_path" />
    <remap from="planner_server" to="gbplanner" />
    <remap from="planner_homing_server" to="gbplanner/homing" />
    <remap from="odometry" to="/odometry"/>
    <rosparam command="load" file="$(arg pci_file)" />
  </node>
  
  <!-- RViz for visualization -->
  <node pkg="rviz" type="rviz" name="gbplanner_ui" output="screen" args="-d $(find gbplanner)/config/rviz/rmf_obelix.rviz"/>
</launch>